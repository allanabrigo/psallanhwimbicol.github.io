<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HWIM BICOL - Healing the World International Ministries</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,800;1,600&display=swap" rel="stylesheet">

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        hwim: {
                            red: '#dc2626',
                            redhover: '#b91c1c',
                            dark: '#0f172a',
                            gold: '#f59e0b',
                            warmbg: '#fafaf9'
                        }
                    },
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                        serif: ['"Playfair Display"', 'serif']
                    }
                }
            }
        }
    </script>

    <style>
        /* Custom subtle pulsing effect for the hero red circle button */
        @keyframes ringPulse {
            0% { transform: scale(0.95); opacity: 0.8; }
            50% { transform: scale(1.25); opacity: 0; }
            100% { transform: scale(0.95); opacity: 0; }
        }
        .animate-ring-pulse {
            animation: ringPulse 2.2s cubic-bezier(0, 0, 0.2, 1) infinite;
        }

        /* Glassmorphism utility */
        .glass-nav {
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }

        /* Hide scrollbar for clean UI in horizontal pills */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="bg-stone-50 text-slate-800 font-sans antialiased selection:bg-red-500 selection:text-white">

    <!-- HEADER / NAVIGATION -->
    <header class="fixed top-0 left-0 w-full z-50 glass-nav border-b border-slate-800/60 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-20">
                
                <!-- UPPERMOST LEFT SIDE LOGO & TITLE (User Requirement 1) -->
                <a href="#hero" class="flex items-center gap-3 group">
                    <div class="w-10 h-10 rounded-full bg-red-600 flex items-center justify-center text-white shadow-lg shadow-red-600/30 group-hover:scale-105 transition-transform duration-300">
                        <i class="fa-solid fa-cross text-lg"></i>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-xl sm:text-2xl font-extrabold tracking-wider text-white font-serif group-hover:text-red-400 transition-colors">
                            HWIM BICOL
                        </span>
                        <span class="text-[10px] text-slate-400 font-medium tracking-widest uppercase">
                            Healing the World Intl
                        </span>
                    </div>
                </a>

                <!-- Desktop Navigation Links -->
                <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-slate-300">
                    <a href="#hero" class="hover:text-red-400 transition-colors">Home</a>
                    <a href="#documentation" class="hover:text-red-400 transition-colors flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-red-500 inline-block animate-pulse"></span>
                        Activities & Docs
                    </a>
                    <a href="#impact" class="hover:text-red-400 transition-colors">Our Impact</a>
                    <a href="#gallery" class="hover:text-red-400 transition-colors">Photo Gallery</a>
                    <a href="#about" class="hover:text-red-400 transition-colors">About Ministry</a>
                </nav>

                <!-- Call to Action Button -->
                <div class="hidden sm:flex items-center gap-4">
                    <a href="#contact" class="px-5 py-2.5 rounded-full bg-red-600 text-white font-semibold text-sm shadow-md shadow-red-600/30 hover:bg-red-700 transition-all hover:shadow-lg hover:-translate-y-0.5">
                        <i class="fa-solid fa-heart mr-2 text-xs"></i>Get Involved
                    </a>
                </div>

                <!-- Mobile Menu Button -->
                <button id="mobile-menu-btn" class="md:hidden text-slate-300 hover:text-white text-2xl focus:outline-none p-2" aria-label="Toggle Navigation Menu">
                    <i class="fa-solid fa-bars" id="menu-icon"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Menu Dropdown -->
        <div id="mobile-menu" class="hidden md:hidden bg-slate-900/95 border-b border-slate-800 px-4 pt-2 pb-6 space-y-3">
            <a href="#hero" class="mobile-link block px-3 py-2 rounded-lg text-slate-200 hover:bg-slate-800 hover:text-red-400 font-medium">Home</a>
            <a href="#documentation" class="mobile-link block px-3 py-2 rounded-lg text-slate-200 hover:bg-slate-800 hover:text-red-400 font-medium">Activities & Documentation</a>
            <a href="#impact" class="mobile-link block px-3 py-2 rounded-lg text-slate-200 hover:bg-slate-800 hover:text-red-400 font-medium">Our Impact</a>
            <a href="#gallery" class="mobile-link block px-3 py-2 rounded-lg text-slate-200 hover:bg-slate-800 hover:text-red-400 font-medium">Photo Gallery</a>
            <a href="#about" class="mobile-link block px-3 py-2 rounded-lg text-slate-200 hover:bg-slate-800 hover:text-red-400 font-medium">About HWIM Bicol</a>
            <a href="#contact" class="mobile-link block w-full text-center mt-3 px-5 py-2.5 rounded-full bg-red-600 text-white font-semibold text-sm">Get Involved</a>
        </div>
    </header>

    <!-- HERO SECTION -->
    <section id="hero" class="relative min-h-screen bg-slate-950 text-white pt-28 pb-20 flex items-center justify-center overflow-hidden">
        <!-- Hero Background Visual Effects -->
        <div class="absolute inset-0 z-0 opacity-20 bg-[radial-gradient(#dc2626_1px,transparent_1px)] [background-size:24px_24px]"></div>
        <div class="absolute -top-40 -right-40 w-96 h-96 bg-red-600/30 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-amber-600/20 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 text-center pt-10">
            
            <!-- Welcome Badge -->
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-red-950/80 border border-red-700/50 text-red-300 text-xs sm:text-sm font-semibold tracking-wide uppercase mb-8 shadow-inner">
                <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
                Welcome to Healing the World Intl Ministries — Bicol
            </div>

            <!-- Main Hero Title -->
            <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-white font-serif leading-[1.15] mb-6">
                Transforming Lives Across <br class="hidden sm:inline"/>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 via-amber-400 to-red-400">
                    Bicol Through Faith & Mission
                </span>
            </h1>

            <p class="max-w-2xl mx-auto text-base sm:text-lg text-slate-300 leading-relaxed mb-10 font-light">
                Documenting our spiritual journey, community outreach programs, youth fellowship, and divine service throughout the Bicol Region.
            </p>

            <!-- RED CIRCULAR BUTTON DIRECTLY BELOW HERO TITLE (User Requirement 2) -->
            <div class="flex flex-col items-center justify-center space-y-4">
                <div class="relative flex items-center justify-center group">
                    <!-- Outer glowing pulse rings -->
                    <div class="absolute inset-0 rounded-full bg-red-600/40 animate-ring-pulse pointer-events-none"></div>
                    <div class="absolute -inset-2 rounded-full bg-red-500/20 blur-md group-hover:bg-red-500/40 transition-all"></div>
                    
                    <!-- THE RED CIRCLE SHAPE BUTTON -->
                    <button id="hero-doc-btn" onclick="scrollToDocumentation()" class="relative z-10 w-24 h-24 sm:w-28 sm:h-28 rounded-full bg-gradient-to-tr from-red-700 via-red-600 to-red-500 text-white shadow-2xl shadow-red-600/60 flex flex-col items-center justify-center transform group-hover:scale-110 active:scale-95 transition-all duration-300 border-2 border-red-400/50 focus:outline-none focus:ring-4 focus:ring-red-400/50" aria-label="Open Church Activities Documentation">
                        <i class="fa-solid fa-folder-open text-2xl sm:text-3xl mb-1 group-hover:bounce transition-transform"></i>
                        <span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-red-100 text-center px-1 leading-tight">
                            View<br>Docs
                        </span>
                    </button>
                </div>

                <!-- Guidance label below the red circle button -->
                <div class="flex items-center gap-2 text-sm text-red-300 font-semibold animate-bounce mt-2">
                    <i class="fa-solid fa-circle-arrow-down text-red-400"></i>
                    <span>Click to explore Church Activities Documentation</span>
                </div>
            </div>

        </div>
    </section>

    <!-- STATS / QUICK HIGHLIGHTS BAR -->
    <section id="impact" class="bg-white border-y border-slate-200 py-12 relative z-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
                <div class="p-4 rounded-2xl bg-stone-50 border border-slate-100 shadow-sm">
                    <div class="text-3xl sm:text-4xl font-extrabold text-red-600 font-serif mb-1">120+</div>
                    <div class="text-xs sm:text-sm font-semibold text-slate-600 uppercase tracking-wider">Outreach Drives</div>
                </div>
                <div class="p-4 rounded-2xl bg-stone-50 border border-slate-100 shadow-sm">
                    <div class="text-3xl sm:text-4xl font-extrabold text-amber-600 font-serif mb-1">15k+</div>
                    <div class="text-xs sm:text-sm font-semibold text-slate-600 uppercase tracking-wider">Bicolanos Served</div>
                </div>
                <div class="p-4 rounded-2xl bg-stone-50 border border-slate-100 shadow-sm">
                    <div class="text-3xl sm:text-4xl font-extrabold text-red-600 font-serif mb-1">6</div>
                    <div class="text-xs sm:text-sm font-semibold text-slate-600 uppercase tracking-wider">Bicol Provinces</div>
                </div>
                <div class="p-4 rounded-2xl bg-stone-50 border border-slate-100 shadow-sm">
                    <div class="text-3xl sm:text-4xl font-extrabold text-slate-900 font-serif mb-1">500+</div>
                    <div class="text-xs sm:text-sm font-semibold text-slate-600 uppercase tracking-wider">Youth Members</div>
                </div>
            </div>
        </div>
    </section>

    <!-- CHURCH ACTIVITIES DOCUMENTATION SECTION (User Requirement 3) -->
    <section id="documentation" class="py-20 bg-stone-100 relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Section Header -->
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 pb-6 border-b border-slate-300 gap-6">
                <div>
                    <div class="inline-flex items-center gap-2 text-red-600 font-extrabold text-xs tracking-widest uppercase mb-2">
                        <i class="fa-solid fa-book-bookmark"></i> HWIM Archive & Records
                    </div>
                    <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 font-serif">
                        Church Activities Documentation
                    </h2>
                    <p class="text-slate-600 mt-2 max-w-xl text-sm sm:text-base">
                        Comprehensive reports, photo archives, and ministry impact records of HWIM Bicol events and community missions.
                    </p>
                </div>

                <!-- Search Input Bar -->
                <div class="relative w-full md:w-80">
                    <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                    <input type="text" id="doc-search-input" placeholder="Search activities, locations..." class="w-full pl-11 pr-4 py-3 rounded-full bg-white border border-slate-300 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 shadow-sm transition-all" oninput="filterActivities()">
                </div>
            </div>

            <!-- Category Filter Pills -->
            <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-8 no-scrollbar" id="category-pills">
                <button onclick="setCategoryFilter('all')" class="cat-pill active px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold whitespace-nowrap bg-red-600 text-white shadow-md transition-all">
                    All Activities
                </button>
                <button onclick="setCategoryFilter('Outreach')" class="cat-pill px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold whitespace-nowrap bg-white text-slate-700 hover:bg-slate-200 border border-slate-300 shadow-sm transition-all">
                    Outreach
                </button>
                <button onclick="setCategoryFilter('Sunday Services')" class="cat-pill px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold whitespace-nowrap bg-white text-slate-700 hover:bg-slate-200 border border-slate-300 shadow-sm transition-all">
                    Sunday Services
                </button>
                <button onclick="setCategoryFilter('Youth Ministry')" class="cat-pill px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold whitespace-nowrap bg-white text-slate-700 hover:bg-slate-200 border border-slate-300 shadow-sm transition-all">
                    Youth Ministry
                </button>
                <button onclick="setCategoryFilter('Community Missions in Bicol')" class="cat-pill px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold whitespace-nowrap bg-white text-slate-700 hover:bg-slate-200 border border-slate-300 shadow-sm transition-all">
                    Community Missions in Bicol
                </button>
            </div>

            <!-- Documentation Cards Grid Container -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="activities-grid">
                <!-- Dynamic Content Rendered via JavaScript -->
            </div>

            <!-- Empty State Notice -->
            <div id="no-results" class="hidden text-center py-16 bg-white rounded-3xl border border-dashed border-slate-300">
                <i class="fa-solid fa-folder-open text-5xl text-slate-300 mb-3"></i>
                <h3 class="text-lg font-bold text-slate-700">No activity documentation found</h3>
                <p class="text-slate-500 text-sm mt-1">Try adjusting your search terms or selecting a different category.</p>
                <button onclick="resetFilters()" class="mt-4 px-4 py-2 bg-slate-800 text-white text-xs font-semibold rounded-lg hover:bg-slate-700">
                    Reset Filters
                </button>
            </div>

        </div>
    </section>

    <!-- PHOTO GALLERY SECTION -->
    <section id="gallery" class="py-20 bg-slate-900 text-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-2xl mx-auto mb-14">
                <span class="text-red-400 font-extrabold text-xs tracking-widest uppercase">Visual Testimony</span>
                <h2 class="text-3xl sm:text-4xl font-extrabold font-serif mt-2">Bicol Ministry Gallery</h2>
                <p class="text-slate-400 text-sm sm:text-base mt-2">Moments of worship, joy, and service caught on camera across our Bicol congregations.</p>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4" id="gallery-grid">
                <!-- Gallery Images Rendered via JS -->
            </div>
        </div>
    </section>

    <!-- DOCUMENTATION DETAIL MODAL -->
    <div id="doc-modal" class="fixed inset-0 z-50 hidden overflow-y-auto bg-slate-950/80 backdrop-blur-md flex items-center justify-center p-4 sm:p-6">
        <div class="relative bg-white rounded-3xl max-w-3xl w-full overflow-hidden shadow-2xl border border-slate-200 transform transition-all my-8">
            
            <!-- Modal Header image / gradient -->
            <div id="modal-hero-bg" class="h-48 sm:h-64 bg-slate-800 relative bg-cover bg-center flex items-end p-6">
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-transparent"></div>
                <button onclick="closeModal()" class="absolute top-4 right-4 w-10 h-10 rounded-full bg-slate-900/80 text-white hover:bg-red-600 transition-colors flex items-center justify-center z-10">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
                <div class="relative z-10 text-white">
                    <span id="modal-category" class="px-3 py-1 rounded-full bg-red-600 text-[11px] font-bold uppercase tracking-wider mb-2 inline-block">Category</span>
                    <h3 id="modal-title" class="text-2xl sm:text-3xl font-extrabold font-serif">Activity Title</h3>
                </div>
            </div>

            <!-- Modal Content Body -->
            <div class="p-6 sm:p-8 space-y-6">
                <!-- Meta tags -->
                <div class="flex flex-wrap items-center gap-4 text-xs sm:text-sm text-slate-500 pb-4 border-b border-slate-200">
                    <span class="flex items-center gap-1.5"><i class="fa-regular fa-calendar text-red-600"></i> <span id="modal-date">Date</span></span>
                    <span class="flex items-center gap-1.5"><i class="fa-solid fa-location-dot text-red-600"></i> <span id="modal-location">Location</span></span>
                    <span class="flex items-center gap-1.5"><i class="fa-solid fa-users text-red-600"></i> <span id="modal-attendees">Participants</span></span>
                </div>

                <!-- Report Content -->
                <div>
                    <h4 class="text-sm font-bold uppercase tracking-wider text-slate-400 mb-2">Executive Activity Summary</h4>
                    <p id="modal-description" class="text-slate-700 leading-relaxed text-sm sm:text-base">
                        Full report documentation content...
                    </p>
                </div>

                <!-- Key Highlights -->
                <div class="bg-stone-50 p-4 rounded-2xl border border-slate-200">
                    <h5 class="font-bold text-slate-900 text-sm mb-2 flex items-center gap-2">
                        <i class="fa-solid fa-star text-amber-500"></i> Impact & Outcomes
                    </h5>
                    <ul id="modal-highlights" class="list-disc list-inside text-xs sm:text-sm text-slate-600 space-y-1">
                        <!-- Key points -->
                    </ul>
                </div>

                <!-- Action buttons -->
                <div class="flex items-center justify-between pt-4 border-t border-slate-200">
                    <button onclick="downloadMockPDF()" class="px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs sm:text-sm font-bold transition-colors flex items-center gap-2">
                        <i class="fa-solid fa-file-pdf text-red-600"></i> Export Summary PDF
                    </button>
                    <button onclick="closeModal()" class="px-6 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs sm:text-sm font-bold transition-colors">
                        Close Report
                    </button>
                </div>
            </div>

        </div>
    </div>

    <!-- LIGHTBOX MODAL FOR GALLERY -->
    <div id="lightbox-modal" class="fixed inset-0 z-50 hidden bg-slate-950/95 flex items-center justify-center p-4">
        <button onclick="closeLightbox()" class="absolute top-6 right-6 text-white text-3xl hover:text-red-400 z-10">
            <i class="fa-solid fa-xmark"></i>
        </button>
        <div class="max-w-4xl max-h-[85vh] text-center">
            <img id="lightbox-img" src="" alt="Enlarged photo" class="max-w-full max-h-[75vh] rounded-2xl shadow-2xl mx-auto object-contain">
            <p id="lightbox-caption" class="text-slate-300 text-sm mt-4 font-medium"></p>
        </div>
    </div>

    <!-- ABOUT & MISSION SECTION -->
    <section id="about" class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                <div class="relative">
                    <img src="https://images.unsplash.com/photo-1511632765486-a01980e01a18?auto=format&fit=crop&q=80&w=1000" alt="HWIM Bicol Community" class="rounded-3xl shadow-2xl w-full object-cover h-[400px]">
                    <div class="absolute -bottom-6 -right-6 bg-red-600 text-white p-6 rounded-3xl shadow-xl hidden sm:block max-w-xs">
                        <i class="fa-solid fa-quote-left text-2xl text-red-300 mb-2"></i>
                        <p class="text-xs font-semibold italic">"Healing broken hearts, empowering communities across Bicol."</p>
                    </div>
                </div>

                <div class="space-y-6">
                    <span class="text-red-600 font-extrabold text-xs tracking-widest uppercase">About HWIM BICOL</span>
                    <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 font-serif">
                        Dedicated to Spiritual Renewal & Community Service
                    </h2>
                    <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
                        Healing the World International Ministries (HWIM) Bicol Chapter is committed to bringing spiritual growth, holistic community development, and emergency relief services across all six Bicol provinces: Albay, Camarines Sur, Camarines Norte, Catanduanes, Masbate, and Sorsogon.
                    </p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
                        <div class="flex items-start gap-3">
                            <div class="w-8 h-8 rounded-lg bg-red-100 text-red-600 flex items-center justify-center shrink-0 mt-1">
                                <i class="fa-solid fa-hands-holding-child"></i>
                            </div>
                            <div>
                                <h4 class="font-bold text-slate-900 text-sm">Youth & Children</h4>
                                <p class="text-xs text-slate-500">Values education and youth leadership empowerment.</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-3">
                            <div class="w-8 h-8 rounded-lg bg-red-100 text-red-600 flex items-center justify-center shrink-0 mt-1">
                                <i class="fa-solid fa-bowl-food"></i>
                            </div>
                            <div>
                                <h4 class="font-bold text-slate-900 text-sm">Relief & Feeding</h4>
                                <p class="text-xs text-slate-500">Typhoon response and nutritional drives for barangays.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CONTACT & SERVICE TIMES -->
    <section id="contact" class="py-20 bg-stone-900 text-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
                <div>
                    <span class="text-red-400 font-extrabold text-xs tracking-widest uppercase">Visit Us</span>
                    <h2 class="text-3xl font-extrabold font-serif mt-2 mb-6">Service Times & Location</h2>
                    
                    <div class="space-y-4 text-slate-300 text-sm">
                        <div class="flex items-start gap-4 p-4 rounded-2xl bg-slate-800/60 border border-slate-700">
                            <i class="fa-solid fa-church text-red-400 text-xl mt-1"></i>
                            <div>
                                <h4 class="font-bold text-white">Sunday Celebration Service</h4>
                                <p class="text-slate-400 text-xs mt-0.5">First Service: 8:00 AM | Second Service: 10:30 AM</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-4 p-4 rounded-2xl bg-slate-800/60 border border-slate-700">
                            <i class="fa-solid fa-fire text-amber-400 text-xl mt-1"></i>
                            <div>
                                <h4 class="font-bold text-white">Youth Fellowship & Worship</h4>
                                <p class="text-slate-400 text-xs mt-0.5">Every Saturday at 4:00 PM</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-4 p-4 rounded-2xl bg-slate-800/60 border border-slate-700">
                            <i class="fa-solid fa-location-dot text-red-400 text-xl mt-1"></i>
                            <div>
                                <h4 class="font-bold text-white">Bicol Regional Headquarters</h4>
                                <p class="text-slate-400 text-xs mt-0.5">HWIM Worship Center, Bicol Region, Philippines</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Contact Message Form -->
                <div class="bg-slate-800 p-6 sm:p-8 rounded-3xl border border-slate-700">
                    <h3 class="text-xl font-bold mb-4">Send Us a Message</h3>
                    <form onsubmit="handleContactSubmit(event)" class="space-y-4">
                        <div>
                            <label class="block text-xs font-semibold uppercase text-slate-400 mb-1">Your Full Name</label>
                            <input type="text" required placeholder="Juan Dela Cruz" class="w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-sm text-white focus:outline-none focus:border-red-500">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold uppercase text-slate-400 mb-1">Email / Mobile No.</label>
                            <input type="text" required placeholder="juandelacruz@gmail.com" class="w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-sm text-white focus:outline-none focus:border-red-500">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold uppercase text-slate-400 mb-1">Message / Prayer Request</label>
                            <textarea rows="3" required placeholder="How can HWIM Bicol pray for or serve you?" class="w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-sm text-white focus:outline-none focus:border-red-500"></textarea>
                        </div>
                        <button type="submit" class="w-full py-3 rounded-xl bg-red-600 hover:bg-red-700 font-bold text-sm transition-all shadow-lg shadow-red-600/30">
                            Send Message
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="bg-slate-950 text-slate-500 text-xs py-8 border-t border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center sm:flex sm:justify-between sm:items-center">
            <p>&copy; 2026 HWIM BICOL (Healing the World International Ministries). All rights reserved.</p>
            <div class="mt-4 sm:mt-0 flex justify-center space-x-6 text-slate-400">
                <a href="#" class="hover:text-white"><i class="fa-brands fa-facebook text-lg"></i></a>
                <a href="#" class="hover:text-white"><i class="fa-brands fa-youtube text-lg"></i></a>
                <a href="#" class="hover:text-white"><i class="fa-brands fa-instagram text-lg"></i></a>
            </div>
        </div>
    </footer>

    <!-- Notification Toast Container -->
    <div id="toast" class="fixed bottom-6 right-6 z-50 hidden bg-slate-900 text-white px-5 py-3 rounded-2xl shadow-2xl border border-slate-700 flex items-center gap-3 text-sm">
        <i class="fa-solid fa-circle-check text-green-400"></i>
        <span id="toast-msg">Message sent successfully!</span>
    </div>

    <!-- JAVASCRIPT LOGIC -->
    <script>
        // Database of Church Activity Documentations
        const activitiesData = [
            {
                id: 1,
                title: "Bicol Community Typhoon Relief & Care Drive",
                category: "Community Missions in Bicol",
                date: "February 14, 2026",
                location: "Iriga City & Nabua, Camarines Sur",
                attendees: "450+ Families",
                image: "https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?auto=format&fit=crop&q=80&w=600",
                summary: "Emergency food package distribution, clean water supply, and trauma counseling for affected families following heavy regional rains.",
                highlights: [
                    "Distributed 450+ relief sacks containing rice and basic essentials.",
                    "Deployed medical volunteers for routine health checks.",
                    "Organized kids' prayer and encouragement sessions."
                ]
            },
            {
                id: 2,
                title: "Youth Alive Revival Encounter & Worship Night",
                category: "Youth Ministry",
                date: "January 28, 2026",
                location: "Naga City Cultural Hub",
                attendees: "320 Youth Delegates",
                image: "https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?auto=format&fit=crop&q=80&w=600",
                summary: "An empowering gathering of young Bicolanos focused on spiritual growth, leadership workshops, and passionate praise worship.",
                highlights: [
                    "Over 300 youth participants across Camarines Sur.",
                    "Breakout sessions on mental wellness, faith, and purpose.",
                    "Formed 12 new campus fellowship groups."
                ]
            },
            {
                id: 3,
                title: "Grand Sunday Thanksgiving & Healing Service",
                category: "Sunday Services",
                date: "March 1, 2026",
                location: "HWIM Main Bicol Sanctuary",
                attendees: "600+ Congregants",
                image: "https://images.unsplash.com/photo-1438232992991-995b7058bbb3?auto=format&fit=crop&q=80&w=600",
                summary: "A powerful Sunday service celebrating God's faithfulness in the Bicol region with communion and special choir presentations.",
                highlights: [
                    "Inspiring message on faith in challenging times.",
                    "Child dedication ceremony for 15 newborn babies.",
                    "Launch of regional prayer intercession network."
                ]
            },
            {
                id: 4,
                title: "Barangay Health & Nutritional Feeding Outreach",
                category: "Outreach",
                date: "February 22, 2026",
                location: "Legazpi City, Albay",
                attendees: "200 Children Served",
                image: "https://images.unsplash.com/photo-1509099836639-18ba1795216d?auto=format&fit=crop&q=80&w=600",
                summary: "Providing hot nutritious meals, vitamins, and hygiene kits to elementary school children in rural barangays.",
                highlights: [
                    "Served warm meals to over 200 children.",
                    "Distributed free toothbrush & hygiene kits.",
                    "Conducted health hygiene teaching session."
                ]
            },
            {
                id: 5,
                title: "Bicol Regional Pastors & Leaders Summit",
                category: "Community Missions in Bicol",
                date: "January 15, 2026",
                location: "Sorsogon City Training Center",
                attendees: "85 Ministry Leaders",
                image: "https://images.unsplash.com/photo-1529070538774-1843cb3265df?auto=format&fit=crop&q=80&w=600",
                summary: "Equipping pastors and church leaders with modern ministry tools, community mobilization strategies, and biblical leadership principles.",
                highlights: [
                    "2-day intensive leadership retreat.",
                    "Strategic planning for 2026 regional church planting.",
                    "Cross-provincial leadership unity covenant."
                ]
            },
            {
                id: 6,
                title: "Weekly Children's Values & Sunday School",
                category: "Sunday Services",
                date: "Weekly Ongoing",
                location: "All HWIM Bicol Satellite Hubs",
                attendees: "250+ Children Weekly",
                image: "https://images.unsplash.com/photo-1503676260728-1c00da094a0b?auto=format&fit=crop&q=80&w=600",
                summary: "Interactive Bible story lessons, arts and crafts, and foundational moral values education for children across Bicol.",
                highlights: [
                    "Engaging Bible lessons through puppetry and storytelling.",
                    "Weekly snacks and educational materials.",
                    "Active participation of volunteer teachers."
                ]
            }
        ];

        // Photo Gallery Images Data
        const galleryData = [
            { url: "https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?auto=format&fit=crop&q=80&w=800", caption: "Youth Night Praise & Worship" },
            { url: "https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?auto=format&fit=crop&q=80&w=800", caption: "Community Relief Mission in Camarines Sur" },
            { url: "https://images.unsplash.com/photo-1438232992991-995b7058bbb3?auto=format&fit=crop&q=80&w=800", caption: "Sunday Worship Gathering" },
            { url: "https://images.unsplash.com/photo-1509099836639-18ba1795216d?auto=format&fit=crop&q=80&w=800", caption: "Barangay Kids Feeding Program" },
            { url: "https://images.unsplash.com/photo-1511632765486-a01980e01a18?auto=format&fit=crop&q=80&w=800", caption: "Bicol Leadership Fellowship" },
            { url: "https://images.unsplash.com/photo-1529070538774-1843cb3265df?auto=format&fit=crop&q=80&w=800", caption: "Ministry Equipping Seminar" },
            { url: "https://images.unsplash.com/photo-1503676260728-1c00da094a0b?auto=format&fit=crop&q=80&w=800", caption: "Children Sunday School" },
            { url: "https://images.unsplash.com/photo-1469571486292-0ba58a3f068b?auto=format&fit=crop&q=80&w=800", caption: "Volunteers Serving Local Barangays" }
        ];

        let currentCategory = 'all';

        // Render Activity Cards
        function renderActivities() {
            const grid = document.getElementById('activities-grid');
            const noResults = document.getElementById('no-results');
            const searchVal = document.getElementById('doc-search-input').value.toLowerCase();

            const filtered = activitiesData.filter(act => {
                const matchesCategory = (currentCategory === 'all') || (act.category === currentCategory);
                const matchesSearch = act.title.toLowerCase().includes(searchVal) || 
                                      act.location.toLowerCase().includes(searchVal) ||
                                      act.summary.toLowerCase().includes(searchVal) ||
                                      act.category.toLowerCase().includes(searchVal);
                return matchesCategory && matchesSearch;
            });

            grid.innerHTML = '';

            if (filtered.length === 0) {
                noResults.classList.remove('hidden');
                return;
            } else {
                noResults.classList.add('hidden');
            }

            filtered.forEach(act => {
                const card = document.createElement('div');
                card.className = "bg-white rounded-3xl overflow-hidden border border-slate-200 shadow-md hover:shadow-xl transition-all duration-300 flex flex-col group";
                
                card.innerHTML = `
                    <div class="relative h-48 overflow-hidden bg-slate-900">
                        <img src="${act.image}" alt="${act.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-90">
                        <span class="absolute top-4 left-4 px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-red-600 text-white shadow">
                            ${act.category}
                        </span>
                    </div>
                    <div class="p-6 flex-1 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center gap-2 text-xs text-slate-400 mb-2">
                                <span><i class="fa-regular fa-calendar text-red-500 mr-1"></i>${act.date}</span>
                                <span>•</span>
                                <span><i class="fa-solid fa-location-dot text-red-500 mr-1"></i>${act.location}</span>
                            </div>
                            <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-red-600 transition-colors font-serif leading-snug">
                                ${act.title}
                            </h3>
                            <p class="text-slate-600 text-xs sm:text-sm line-clamp-3 leading-relaxed mb-4">
                                ${act.summary}
                            </p>
                        </div>
                        <button onclick="openModal(${act.id})" class="w-full py-2.5 rounded-xl bg-slate-100 hover:bg-red-600 hover:text-white text-slate-800 text-xs font-bold transition-all duration-300 flex items-center justify-center gap-2">
                            <span>Read Full Documentation</span>
                            <i class="fa-solid fa-arrow-right text-xs"></i>
                        </button>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        // Render Photo Gallery
        function renderGallery() {
            const grid = document.getElementById('gallery-grid');
            grid.innerHTML = '';
            galleryData.forEach(item => {
                const div = document.createElement('div');
                div.className = "relative h-48 sm:h-56 rounded-2xl overflow-hidden group cursor-pointer border border-slate-800";
                div.onclick = () => openLightbox(item.url, item.caption);
                div.innerHTML = `
                    <img src="${item.url}" alt="${item.caption}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity p-4 flex items-end">
                        <span class="text-xs font-semibold text-white truncate"><i class="fa-solid fa-camera mr-1 text-red-400"></i> ${item.caption}</span>
                    </div>
                `;
                grid.appendChild(div);
            });
        }

        // Filter Handlers
        function setCategoryFilter(category) {
            currentCategory = category;
            const buttons = document.querySelectorAll('.cat-pill');
            buttons.forEach(btn => {
                if (btn.innerText.trim() === category || (category === 'all' && btn.innerText.includes('All'))) {
                    btn.className = "cat-pill active px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold whitespace-nowrap bg-red-600 text-white shadow-md transition-all";
                } else {
                    btn.className = "cat-pill px-5 py-2.5 rounded-full text-xs sm:text-sm font-bold whitespace-nowrap bg-white text-slate-700 hover:bg-slate-200 border border-slate-300 shadow-sm transition-all";
                }
            });
            renderActivities();
        }

        function filterActivities() {
            renderActivities();
        }

        function resetFilters() {
            document.getElementById('doc-search-input').value = '';
            setCategoryFilter('all');
        }

        // Smooth Scroll to Documentation section (triggered by Red Circle Button)
        function scrollToDocumentation() {
            const docSection = document.getElementById('documentation');
            if (docSection) {
                docSection.scrollIntoView({ behavior: 'smooth' });
            }
        }

        // Modal Open / Close Logic
        function openModal(id) {
            const item = activitiesData.find(a => a.id === id);
            if (!item) return;

            document.getElementById('modal-title').innerText = item.title;
            document.getElementById('modal-category').innerText = item.category;
            document.getElementById('modal-date').innerText = item.date;
            document.getElementById('modal-location').innerText = item.location;
            document.getElementById('modal-attendees').innerText = item.attendees;
            document.getElementById('modal-description').innerText = item.summary;
            document.getElementById('modal-hero-bg').style.backgroundImage = `url('${item.image}')`;

            const highlightsContainer = document.getElementById('modal-highlights');
            highlightsContainer.innerHTML = '';
            item.highlights.forEach(h => {
                const li = document.createElement('li');
                li.innerText = h;
                highlightsContainer.appendChild(li);
            });

            document.getElementById('doc-modal').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        function closeModal() {
            document.getElementById('doc-modal').classList.add('hidden');
            document.body.style.overflow = 'auto';
        }

        // Lightbox Logic
        function openLightbox(url, caption) {
            document.getElementById('lightbox-img').src = url;
            document.getElementById('lightbox-caption').innerText = caption;
            document.getElementById('lightbox-modal').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        function closeLightbox() {
            document.getElementById('lightbox-modal').classList.add('hidden');
            document.body.style.overflow = 'auto';
        }

        // Helper Toast Notification
        function showToast(message) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-msg').innerText = message;
            toast.classList.remove('hidden');
            setTimeout(() => {
                toast.classList.add('hidden');
            }, 3500);
        }

        function handleContactSubmit(e) {
            e.preventDefault();
            showToast("Thank you! Your message has been sent to HWIM Bicol.");
            e.target.reset();
        }

        function downloadMockPDF() {
            showToast("Generating Activity Report Document...");
        }

        // Mobile Menu Toggle
        const menuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        menuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        document.querySelectorAll('.mobile-link').forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
            });
        });

        // Initialize view on load
        window.addEventListener('DOMContentLoaded', () => {
            renderActivities();
            renderGallery();
        });
    </script>
</body>
</html>
